<h1>Profile</h1>
<section>
	<form id="user-profile-form" locked="true">
		<div id="obj_user_name-container" class="input-field" field="obj_user_name" style="width: 300px;">
			<label for="obj_user_name">username</label>
			<input id="obj_user_name" fgta5-component="Textbox"
				placeholder="username" autocomplete="off" spellcheck="false"
				binding="user_name" 
				data-tabindex="2"
				character-case="lowercase"
				disabled
				autocomplete="off" spellcheck="false"
				maxlength="30">
		</div>


		<div id="user-change-password">
			<div style="font-weight: bold; font-size: 1.3rem; margin-bottom: 8px;">Change Password</div>
			<div><input type="password" id="txt_pass1" placeholder="enter new password"></div>
			<div><input type="password" id="txt_pass2" placeholder="re-enter new password"></div>
			<div>
				<button type="button" id="btn_changepassword">Change Password</button>
			</div>
		</div>
	</form>
</section>