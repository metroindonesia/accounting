<section id="reportviewerMain-section" class="fgta5-carousell" data-title="Report Viewer">

	<div id="report-control">
		<div id="filter-container">

			<div style="margin-bottom: 4px; display:flex; column-gap: 5px;">
				<!-- <div style="width: 40px; display: inline-block; text-align: right; margin-right: 4px;">Type</div>
				<select id="isytd">
					<option value="true">Buku besar YTD - all</option>
					<option value="false">Buku besar MTD - all</option>
				</select> -->

				<div style="width: 250px">
