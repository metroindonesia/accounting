<section id="reportviewerMain-section" class="fgta5-carousell" data-title="Report Viewer">

	<div id="lapkeuHeader">
		<!-- <div style="flex-grow: 1;"> -->
		<div id="filter-container">
			<select id="reporttype">
				<optgroup label="Neraca: Month to date ---">
					<option value="nr|all|mtd">Neraca MTD - all</option>
					<option value="nr|unit|mtd">Neraca MTD - unit</option>
					<option value="nr|struct|mtd">Neraca MTD - struct</option>
					<option value="nr|site|mtd">Neraca MTD - site</option>
					<option value="nr|project|mtd">Neraca MTD - project</option>
					<option value="nr|unitsite|mtd">Neraca MTD - unit site</option>
					<option value="nr|unitstruct|mtd">Neraca MTD - unit struct</option>
					<option value="nr|unitproject|mtd">Neraca MTD - unit project</option>
				</optgroup>	
				
				<optgroup label="Neraca Year to date ---">
					<option value="nr|all|ytd">Neraca YTD - all</option>
					<option value="nr|unit|ytd">Neraca YTD - unit</option>
					<option value="nr|struct|ytd">Neraca YTD - struct</option>
					<option value="nr|site|ytd">Neraca YTD - site</option>
					<option value="nr|project|ytd">Neraca YTD - project</option>
					<option value="nr|unitsite|ytd">Neraca YTD - unit site</option>
					<option value="nr|unitstruct|ytd">Neraca YTD - unit struct</option>
					<option value="nr|unitproject|ytd">Neraca YTD - unit project</option>
				</optgroup>	
				
				<optgroup label="Laba Rugi: Month to date ---">
					<option value="lr|all|mtd">Laba Rugi MTD - all</option>
					<option value="lr|unit|mtd">Laba Rugi MTD - unit</option>
					<option value="lr|struct|mtd">Laba Rugi MTD - struct</option>
					<option value="lr|site|mtd">Laba Rugi MTD - site</option>
					<option value="lr|project|mtd">Laba Rugi MTD - project</option>
					<option value="lr|unitsite|mtd">Laba Rugi MTD - site unit</option>
					<option value="lr|unitstruct|mtd">Laba Rugi MTD - site struct</option>
					<option value="lr|unitproject|mtd">Laba Rugi MTD - site project</option>
				</optgroup>	
				
				<optgroup label="Laba Rugi: Year to date ---">
					<option value="lr|all|ytd">Laba Rugi YTD - all</option>
					<option value="lr|unit|ytd">Laba Rugi YTD - unit</option>
					<option value="lr|struct|ytd">Laba Rugi YTD - struct</option>
					<option value="lr|site|ytd">Laba Rugi YTD - site</option>
					<option value="lr|project|ytd">Laba Rugi YTD - project</option>
					<option value="lr|unitsite|ytd">Laba Rugi YTD - site unit</option>
					<option value="lr|unitstruct|ytd">Laba Rugi YTD - site struct</option>
					<option value="lr|unitproject|ytd">Laba Rugi YTD - site project</option>
				</optgroup>	
			
			
			</select>

			<div style="display: flex; flex-direction: column; row-gap: 5px;">
				<select id="unitselect" disabled class="hidden">
					<option value="0">-- pilih unit --</option>
				</select>
					
				<select id="structselect" disabled class="hidden">
					<option value="0">-- pilih structure --</option>
				</select>

				<select id="siteselect" disabled class="hidden">
					<option value="0">-- pilih site --</option>
				</select>

				<input id="projectselect" name="projectselect" list="projectlist" disabled class="hidden"  placeholder="search project...">
				<input type="hidden" id="project_id" name="project_id">
				<datalist id="projectlist"></datalist>


			</div>


			<input type="date" id="rptLapkeu_tgl">
			<button id="btnLoad">Load</button>
			<!-- </div> -->
		</div>

		<div id="btn">
			<button id="btnDownload">Download</button>
			<button id="btnPrint">Cetak</button>
		</div>

	</div>



	<div id="print-media">
		<!-- sESUAIKAN -->
		<%- include(`${moduleDir}/rptlapkeuPage.html`) %>
	</div>
</section>